{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Echelon candidate theme contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "version",
    "light",
    "dark"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "provisional"
    },
    "version": {
      "type": "string"
    },
    "light": {
      "$ref": "#/$defs/palette"
    },
    "dark": {
      "$ref": "#/$defs/palette"
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "surface",
        "text",
        "muted",
        "border",
        "accent"
      ],
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "border": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    }
  }
}
